code = "shader_type canvas_item;
render_mode blend_mix;

global uniform float Annoyance;
global uniform float Sucking;
uniform sampler2D Texture : hint_default_black;



void fragment() {
// Input:4
	vec2 n_out4p0 = UV;


// Input:5
	float n_out5p0 = TIME;


// FloatOp:25
	float n_in25p1 = 200.00000;
	float n_out25p0 = n_out5p0 * n_in25p1;


// FloatFunc:26
	float n_out26p0 = fract(n_out25p0);


// FloatParameter:30
	float n_out30p0 = Annoyance;


// FloatOp:31
	float n_in31p1 = 0.40000;
	float n_out31p0 = n_out30p0 * n_in31p1;


// FloatOp:27
	float n_out27p0 = n_out26p0 * n_out31p0;


// Distance:11
	vec2 n_in11p1 = vec2(0.50000, 0.50000);
	float n_out11p0 = distance(n_out4p0, n_in11p1);


// FloatFunc:24
	float n_out24p0 = 1.0 - n_out11p0;


// Clamp:29
	float n_in29p1 = 0.00000;
	float n_in29p2 = 1.00000;
	float n_out29p0 = clamp(n_out24p0, n_in29p1, n_in29p2);


// FloatOp:28
	float n_out28p0 = n_out27p0 * n_out29p0;


// Mix:23
	vec2 n_in23p1 = vec2(0.50000, 0.50000);
	vec2 n_out23p0 = mix(n_out4p0, n_in23p1, vec2(n_out28p0));


// FloatOp:20
	float n_in20p1 = 3.00000;
	float n_out20p0 = n_out11p0 * n_in20p1;


// FloatOp:16
	float n_in16p1 = -1.50000;
	float n_out16p0 = n_out5p0 * n_in16p1;


// FloatOp:18
	float n_out18p0 = n_out20p0 + n_out16p0;


// FloatOp:19
	float n_in19p1 = 20.00000;
	float n_out19p0 = n_out18p0 * n_in19p1;


// FloatFunc:17
	float n_out17p0 = sin(n_out19p0);


// FloatOp:15
	float n_in15p1 = 0.04000;
	float n_out15p0 = n_out17p0 * n_in15p1;


// FloatParameter:21
	float n_out21p0 = Sucking;


// FloatOp:22
	float n_out22p0 = n_out15p0 * n_out21p0;


// Mix:12
	vec2 n_in12p1 = vec2(0.50000, 0.50000);
	vec2 n_out12p0 = mix(n_out23p0, n_in12p1, vec2(n_out22p0));


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(Texture, n_out12p0);


// Output:0
	COLOR.rgb = vec3(n_out2p0.xyz);


}
