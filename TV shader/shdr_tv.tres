code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D color : source_color, filter_nearest;
uniform float NoiseSpeed = 8.31900024414063;
uniform sampler2D noise : filter_nearest;
uniform float NoiseBrightness = 2.0;
uniform sampler2D mask : filter_nearest;



void fragment() {
	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(color, UV);


// UVFunc:8
	vec2 n_in8p1 = vec2(8.00000, 8.00000);
	vec2 n_in8p2 = vec2(0.00000, 0.00000);
	vec2 n_out8p0 = (UV - n_in8p2) * n_in8p1 + n_in8p2;


// Input:14
	float n_out14p0 = TIME;


// FloatParameter:16
	float n_out16p0 = NoiseSpeed;


// FloatOp:15
	float n_out15p0 = n_out14p0 * n_out16p0;


// UVFunc:13
	vec2 n_in13p1 = vec2(1.00000, 1.00000);
	vec2 n_out13p0 = vec2(n_out15p0) * n_in13p1 + n_out8p0;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(noise, n_out13p0);


// FloatParameter:18
	float n_out18p0 = NoiseBrightness;


// FloatOp:17
	float n_out17p0 = n_out4p0.x * n_out18p0;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(mask, UV);


// VectorDecompose:3
	float n_out3p0 = vec3(n_out2p0.xyz).x;
	float n_out3p1 = vec3(n_out2p0.xyz).y;
	float n_out3p2 = vec3(n_out2p0.xyz).z;


// Mix:5
	float n_out5p0 = mix(n_out6p0.x, n_out17p0, n_out3p0);


// FloatOp:12
	float n_out12p0 = n_out3p0 * n_out6p0.x;


// Output:0
	ALBEDO = vec3(n_out5p0);
	EMISSION = vec3(n_out12p0);


}
